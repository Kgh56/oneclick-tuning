	{ Id = "PopBang", Name = "Pop & Bang Software", Price = 5000, Desc = "Kunden buchen Pop & Bang (+40 % Geld). Dein Firmenwagen knallt beim Gaswegnehmen." },
}

------------------------------------------------------------------------
