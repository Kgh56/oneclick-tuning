	local pSign = p({ Name = "Parkschild", Size = Vector3.new(6, 2, 0.3), CFrame = at(spotX, 5, 5), Color = Color3.fromRGB(30, 90, 200) })
	textGui(pSign, Enum.NormalId.Back, "P  Firmenwagen", Color3.new(1, 1, 1), Color3.fromRGB(30, 90, 200))
	p({ Name = "Schildpfosten", Size = Vector3.new(0.3, 4, 0.3), CFrame = at(spotX, 2, 5), Color = Color3.fromRGB(120, 120, 125) })
	plot.CarSpot = at(spotX, 0.05 + Cars.CHASSIS_HEIGHT + 0.3, 20) * CFrame.Angles(0, math.pi, 0)

	model.Parent = World.Folder
	buildDyno(plot, hasUpgrade(st, "Dyno"))
	return plot
end

------------------------------------------------------------------------
-- Hebebühnen-Animation und Effekte
------------------------------------------------------------------------
local ORANGE = Color3.fromRGB(255, 140, 0)

local function setLift(bay, h)
	bay.LiftH = h
	for _, lp in ipairs(bay.LiftParts) do
		if lp.Part.Parent then
			lp.Part.CFrame = lp.Base + Vector3.new(0, h, 0)
		end
	end
	local c = bay.Car
	if c and c.OnLift and c.Model.Parent then
		c.Model:PivotTo(bay.CF + Vector3.new(0, h, 0))
	end
end

-- Fährt die Bühne weich auf die Zielhöhe (blockiert, bis fertig)
local function animateLift(bay, target, duration)
	bay.LiftToken = (bay.LiftToken or 0) + 1
	local token = bay.LiftToken
	local from = bay.LiftH or 0
	if math.abs(from - target) < 0.01 then
		return
	end
	if bay.BeaconLight then
		bay.BeaconLight.Enabled = true
		bay.Beacon.Material = Enum.Material.Neon
	end
	local t0 = os.clock()
	while bay.LiftToken == token do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		local e = a * a * (3 - 2 * a)
		setLift(bay, from + (target - from) * e)
		if bay.BeaconLight then
			bay.BeaconLight.Brightness = (math.floor(os.clock() * 5) % 2 == 0) and 4 or 0.3
		end
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if bay.LiftToken == token and bay.BeaconLight then
		bay.BeaconLight.Enabled = false
		bay.Beacon.Material = Enum.Material.SmoothPlastic
	end
end

-- Funkenregen (z. B. wenn die Software fertig ist)
local function sparkle(target)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.6, 1.3)
	pe.Speed = NumberRange.new(8, 18)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80), Color3.fromRGB(80, 255, 140))
	pe.Acceleration = Vector3.new(0, -35, 0)
	pe.Parent = target
	pe:Emit(70)
	task.delay(2.5, function()
		pe:Destroy()
	end)
end

-- Flammen und Licht aus dem Auspuff
local function backfire(carModel, duration)
	for _, d in ipairs(carModel:GetDescendants()) do
		if d.Name == "Auspuff" and d:IsA("BasePart") then
			local f = Instance.new("Fire")
			f.Size = 3
			f.Heat = 4
			f.Color = Color3.fromRGB(255, 110, 20)
			f.SecondaryColor = Color3.fromRGB(255, 230, 90)
			f.Parent = d
			local l = Util.light(d, "PointLight", { Range = 12, Brightness = 3, Color = ORANGE })
			task.delay(duration, function()
				f.Enabled = false
				l:Destroy()
				task.delay(1.5, function()
					f:Destroy()
				end)
			end)
		end
	end
end

-- Abgasrauch
local function exhaustSmoke(carModel, duration)
	for _, d in ipairs(carModel:GetDescendants()) do
		if d.Name == "Auspuff" and d:IsA("BasePart") then
			local sm = Instance.new("Smoke")
			sm.Color = Color3.fromRGB(150, 150, 155)
			sm.Opacity = 0.12
			sm.RiseVelocity = 3
			sm.Size = 2
			sm.Parent = d
			task.delay(duration, function()
				sm.Enabled = false
				task.delay(3, function()
					sm:Destroy()
				end)
			end)
		end
	end
end

-- Leuchtendes Diagnosekabel vom Wagen zum Auto
local function connectCable(bay, carInfo)
	local root = carInfo.Model.PrimaryPart
	if not (root and bay.CartAttachment) then
		return
	end
	local a1 = Instance.new("Attachment")
	a1.Name = "OBD"
	a1.Position = Vector3.new(3.1, 0.2, -1.6)
	a1.Parent = root
	local beam = Instance.new("Beam")
	beam.Attachment0 = bay.CartAttachment
	beam.Attachment1 = a1
	beam.Width0 = 0.18
	beam.Width1 = 0.18
	beam.CurveSize0 = -3
	beam.CurveSize1 = 2
	beam.Segments = 16
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Color = ColorSequence.new(Color3.fromRGB(80, 200, 255))
	beam.Transparency = NumberSequence.new(0.05)
	beam.Parent = root
	local glow = Util.light(root, "PointLight", { Range = 10, Brightness = 1.5, Color = Color3.fromRGB(80, 200, 255) })
	carInfo.Cable = { beam, a1, glow }
end

local function removeCable(carInfo)
	for _, inst in ipairs(carInfo.Cable or {}) do
		inst:Destroy()
	end
	carInfo.Cable = nil
end

local function setCartText(bay, text)
	if bay.CartScreen and bay.CartScreen.Parent then
		bay.CartScreen.Text = text
	end
end

------------------------------------------------------------------------
-- Kunden und Aufträge
------------------------------------------------------------------------
local startJob -- wird weiter unten definiert

local function spawnCustomer(player, st, bay)
	local candidates = {}
	for _, c in ipairs(Config.Cars) do
		if st.Data.Rep >= c.MinRep then
			table.insert(candidates, c)
		end
	end
	local def = candidates[math.random(#candidates)]
	local stage = math.random(1, maxStage(st))
	local car = Cars.MakeShowCar(def)
	local carInfo = { Def = def, Stage = stage, Model = car, Ready = false, Busy = false }
	bay.Car = carInfo

	local plot = st.Plot
	local roadPos = (plot.Origin * CFrame.new(bay.X, 0, ROAD_Z)).Position + Vector3.new(0, CAR_HEIGHT + World.ROAD_TOP, 0)
	local startCF = lookCF(roadPos - Vector3.new(140, 0, 0), Vector3.xAxis)
	local turnCF = lookCF(roadPos, Vector3.xAxis)
	local facingIn = lookCF(roadPos, -Vector3.zAxis)
	car:PivotTo(startCF)
	car.Parent = plot.Model

	task.spawn(function()
		moveModel(car, startCF, turnCF, 3)
		moveModel(car, turnCF, facingIn, 0.6)
		moveModel(car, facingIn, bay.CF, 3)
		if not car.Parent then
			return
		end
		local stageDef = Config.Stages[stage]
		carInfo.Label = billboard(car.PrimaryPart, ("🚗 %s\nWunsch: %s · %d PS"):format(def.Name, stageDef.Name, def.Hp), 5)

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Chiptuning starten"
		prompt.ObjectText = def.Name .. " (" .. stageDef.Name .. ")"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Parent = car.PrimaryPart
		carInfo.Prompt = prompt
		prompt.Triggered:Connect(function(who)
			if who ~= player then
				notify(who, "Das ist nicht deine Werkstatt!", "bad")
				return
			end
			startJob(player, st, bay, carInfo)
		end)
		car.Kollision.CanCollide = true
		carInfo.OnLift = true
		carInfo.Ready = true
	end)
end

local function carLeave(st, bay, carInfo, oldHp, newHp)
	local car = carInfo.Model
	local plot = st.Plot
	if carInfo.Label then
		carInfo.Label.Text = ("✅ Getunt!\n%d → %d PS"):format(oldHp, newHp)
	end
	task.wait(1.5)
	if not car.Parent then
		bay.Car = nil
		return
	end
	animateLift(bay, 0, 2.2)
	carInfo.OnLift = false
	setCartText(bay, "OBD")

	local function floorPos(x, z)
		return (plot.Origin * CFrame.new(x, 0.2 + CAR_HEIGHT, z)).Position
	end

	local front = lookCF(floorPos(bay.X, 12), -Vector3.zAxis)
	moveModel(car, bay.CF, front, 2.2)
	local exitX = bay.X

	if hasUpgrade(st, "Dyno") and not plot.DynoBusy then
		plot.DynoBusy = true
		local dynoCF = lookCF((plot.Origin * CFrame.new(DYNO_POS)).Position + Vector3.new(0, 0.8 + CAR_HEIGHT, 0), -Vector3.zAxis)
		moveModel(car, front, dynoCF, 2)
		local screen = plot.DynoScreen
		local spinning = {}
		for _, d in ipairs(car:GetDescendants()) do
			if d:IsA("BasePart") and (d.Name == "Reifen" or d.Name == "Felge" or d.Name == "Nabe" or d.Name == "Speiche") then
				table.insert(spinning, d)
			end
		end
		if plot.Dyno then
			for _, d in ipairs(plot.Dyno:GetChildren()) do
				if d.Name == "Rolle" then
					table.insert(spinning, d)
				end
			end
		end
		exhaustSmoke(car, 3)
		local t0 = os.clock()
		local last = os.clock()
		local backfired = false
		while car.Parent and os.clock() - t0 < 3.2 do
			local now = os.clock()
			local dt = now - last
			last = now
			local a = math.clamp((now - t0) / 2.6, 0, 1)
			local hp = math.floor(oldHp + (newHp - oldHp) * a)
			local spin = (6 + 30 * a) * dt
			for _, sp in ipairs(spinning) do
				sp.CFrame = sp.CFrame * CFrame.Angles(-spin, 0, 0)
			end
			if screen and screen.Parent then
				screen.Text = ("PRÜFSTAND\n%d PS"):format(hp)
			end
			if carInfo.Label then
				carInfo.Label.Text = ("🔥 Prüfstand\n%d PS"):format(hp)
			end
			if a >= 1 and not backfired then
				backfired = true
				backfire(car, 0.8)
			end
			RunService.Heartbeat:Wait()
		end
		if screen and screen.Parent then
			screen.Text = ("PRÜFSTAND\n%d PS ✔"):format(newHp)
		end
		front = dynoCF
		exitX = DYNO_POS.X
		plot.DynoBusy = false
	end

	local roadPos = (plot.Origin * CFrame.new(exitX, 0, ROAD_Z)).Position + Vector3.new(0, CAR_HEIGHT + World.ROAD_TOP, 0)
	local onRoad = lookCF(roadPos, -Vector3.zAxis)
	moveModel(car, front, onRoad, 2.2)
	local turned = lookCF(roadPos, Vector3.xAxis)
	moveModel(car, onRoad, turned, 0.6)
	moveModel(car, turned, lookCF(roadPos + Vector3.new(160, 0, 0), Vector3.xAxis), 3)
	car:Destroy()
	bay.Car = nil
end

local function completeCar(player, st, bay, score, byAzubi)
	local carInfo = bay.Car
	if not carInfo or carInfo.Done then
		return
	end
	carInfo.Done = true
	carInfo.Ready = false
	carInfo.Busy = true
	local block = carInfo.Model:FindFirstChild("Kollision")
	if block then
		block.CanCollide = false
	end
	removeCable(carInfo)
	setCartText(bay, "✔ " .. Config.Stages[carInfo.Stage].Name)
	if carInfo.Model.PrimaryPart then
		sparkle(carInfo.Model.PrimaryPart)
	end
	backfire(carInfo.Model, 1.2)
	if carInfo.Prompt then
		carInfo.Prompt:Destroy()
		carInfo.Prompt = nil
	end

	local def = carInfo.Def
	local stageDef = Config.Stages[carInfo.Stage]
	local quality = 0.5 + 0.5 * score
	local newHp = math.floor(def.Hp * (1 + stageDef.PowerGain * quality) + 0.5)
	local newNm = math.floor(def.Nm * (1 + stageDef.TorqueGain * quality) + 0.5)

	local mult = (0.4 + 0.6 * score) * def.PayMult * (1 + math.min(st.Data.Rep, 500) / 500)
	if hasUpgrade(st, "Dyno") then
		mult *= Config.DynoBonus
	end
	if hasPass(st, "DoubleMoney") then
		mult *= Config.DoubleMoneyMult
	end
	if hasPass(st, "VIP") then
		mult *= Config.VipMult
	end
	local pay = math.floor(stageDef.BasePay * mult)

	local repDelta
	if score >= 0.95 then
		repDelta = 3
	elseif score >= 0.55 then
		repDelta = 1
	else
		repDelta = -2
	end
	if byAzubi then
		repDelta = math.min(repDelta, 1)
	end

	setMoney(st, st.Data.Money + pay)
	setRep(st, math.max(0, st.Data.Rep + repDelta))
	st.Data.Tunes += 1

	if byAzubi then
		notify(player, ("🧑‍🔧 Azubi hat den %s getunt: +%s €"):format(def.Name, Config.Format(pay)), "good")
	else
		local tip = math.floor(pay * Config.TestDriveTip)
		st.LastTuned = { Def = def, Hp = newHp, Tip = tip, Expires = os.clock() + 120, Used = false }
		TuneResult:FireClient(player, {
			CanTestDrive = true,
			Tip = tip,
			CarName = def.Name,
			StageName = stageDef.Name,
			Hp = def.Hp,
			Nm = def.Nm,
			NewHp = newHp,
			NewNm = newNm,
			Pay = pay,
			RepDelta = repDelta,
			Score = score,
		})
	end

	task.spawn(carLeave, st, bay, carInfo, def.Hp, newHp)
end

startJob = function(player, st, bay, carInfo)
	if not carInfo.Ready or carInfo.Busy or carInfo.Done then
		return
	end
	if st.Job then
		notify(player, "Du tunst gerade schon ein Auto.", "bad")
		return
	end
	local stageDef = Config.Stages[carInfo.Stage]
	local width = hasUpgrade(st, "Laptop") and Config.ZoneWidthLaptop or Config.ZoneWidth
	local zones, speeds = {}, {}
	for r = 1, #Config.MapNames do
		zones[r] = 0.15 + math.random() * 0.7
		speeds[r] = (0.55 + 0.15 * (r - 1)) * stageDef.SpeedMult
	end
	jobCounter += 1
	st.Job = { Id = jobCounter, Bay = bay, Car = carInfo, Zones = zones, Width = width, Started = os.clock() }
	carInfo.Busy = true
	-- Bühne hoch, Diagnosekabel anschließen
	connectCable(bay, carInfo)
	setCartText(bay, "ECU lesen …")
	task.spawn(animateLift, bay, LIFT_UP, 2.5)

	local def = carInfo.Def
	OpenTuning:FireClient(player, {
		Id = jobCounter,
		CarName = def.Name,
		StageName = stageDef.Name,
		Hp = def.Hp,
		Nm = def.Nm,
		TargetHp = math.floor(def.Hp * (1 + stageDef.PowerGain) + 0.5),
		TargetNm = math.floor(def.Nm * (1 + stageDef.TorqueGain) + 0.5),
		Zones = zones,
		Width = width,
		Speeds = speeds,
		MapNames = Config.MapNames,
	})
end

FinishTuning.OnServerEvent:Connect(function(player, jobId, positions)
	local st = States[player]
	if not st or not st.Job or st.Job.Id ~= jobId or type(positions) ~= "table" then
		return
	end
	local job = st.Job
	st.Job = nil
	if os.clock() - job.Started < 1.5 or job.Bay.Car ~= job.Car then
		job.Car.Busy = false
		removeCable(job.Car)
		task.spawn(animateLift, job.Bay, 0, 2)
		return
	end
	local total = 0
	for r = 1, #job.Zones do
		local p = tonumber(positions[r])
		if p == nil or p ~= p then
			p = -1
		end
		p = math.clamp(p, -1, 2)
		total += Config.Score[Config.Rate(p, job.Zones[r], job.Width)]
	end
	completeCar(player, st, job.Bay, total / #job.Zones, false)
end)

CancelTuning.OnServerEvent:Connect(function(player, jobId)
	local st = States[player]
	if st and st.Job and st.Job.Id == jobId then
		local job = st.Job
		job.Car.Busy = false
		st.Job = nil
		removeCable(job.Car)
		setCartText(job.Bay, "OBD")
		task.spawn(animateLift, job.Bay, 0, 2)
	end
end)

------------------------------------------------------------------------
-- Shop
------------------------------------------------------------------------
BuyUpgrade.OnServerEvent:Connect(function(player, id)
	local st = States[player]
	if not st or not st.Plot or type(id) ~= "string" then
		return
	end
	local up = Config.GetUpgrade(id)
	if not up then
		return
	end
	if hasUpgrade(st, id) then
		notify(player, "Hast du schon.", "info")
		return
	end
	if up.Requires and not hasUpgrade(st, up.Requires) then
		notify(player, "Zuerst brauchst du: " .. Config.GetUpgrade(up.Requires).Name, "bad")
		return
	end
	if st.Data.Money < up.Price then
		notify(player, "Nicht genug Geld!", "bad")
		return
	end
	setMoney(st, st.Data.Money - up.Price)
	st.Data.Upgrades[id] = true
	player:SetAttribute("Upg_" .. id, true)

	local bayIndex = tonumber(id:match("^Bay(%d)$"))
	if bayIndex then
		local bay = st.Plot.Bays[bayIndex]
		if bay and bay.Lock then
			bay.Lock:Destroy()
			bay.Lock = nil
		end
	elseif id == "Dyno" then
		buildDyno(st.Plot, true)
	end
	notify(player, "✔ Gekauft: " .. up.Name, "good")
	saveData(player, st)
end)

------------------------------------------------------------------------
-- Fahren: Probefahrt und Firmenwagen
------------------------------------------------------------------------
local function getHumanoid(player)
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid"), char
end

local function teleportHome(player, st)
	local hum, char = getHumanoid(player)
	if hum and char and st.Plot then
		hum.Sit = false
		char:PivotTo(st.Plot.Origin * CFrame.new(0, 4, 28))
	end
end

local function endDrive(player, st, reason)
	local drive = st.Drive
	if not drive then
		return
	end
	st.Drive = nil
	local hum = getHumanoid(player)
	if hum and hum.SeatPart and hum.SeatPart:IsDescendantOf(drive.Car) then
		hum.Sit = false
	end
	drive.Car:Destroy()
	if drive.Mode == "test" then
		local driven = os.clock() - drive.Started
		if drive.Tip and drive.Tip > 0 and driven >= Config.TestDriveMinSeconds then
			setMoney(st, st.Data.Money + drive.Tip)
			notify(player, ("🏁 Der Kunde ist begeistert! Trinkgeld: +%s €"):format(Config.Format(drive.Tip)), "good")
		elseif reason == "time" then
			notify(player, "Die Zeit ist um – Probefahrt beendet.", "info")
		elseif reason ~= "silent" then
			notify(player, ("Probefahrt beendet. (Für Trinkgeld mindestens %d Sekunden fahren.)"):format(Config.TestDriveMinSeconds), "info")
		end
		task.delay(0.2, teleportHome, player, st)
	end
end

local function spawnDrivable(player, st, def, hp, cf, mode)
	endDrive(player, st, "silent")
	local car, seat = Cars.MakeDrivable(def)
	car:PivotTo(cf)
	seat:SetAttribute("Drivable", true)
	seat:SetAttribute("Hp", hp)
	seat:SetAttribute("Owner", player.UserId)
	seat:SetAttribute("Mode", mode)
	seat:SetAttribute("CarName", def.Name)
	local drive = { Car = car, Seat = seat, Mode = mode, Started = os.clock() }
	if mode == "test" then
		drive.Ends = os.clock() + Config.TestDriveSeconds
		seat:SetAttribute("EndsAt", workspace:GetServerTimeNow() + Config.TestDriveSeconds)
	end
	car.Parent = World.Vehicles
	st.Drive = drive
	pcall(function()
		car.PrimaryPart:SetNetworkOwner(player)
	end)

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occ = seat.Occupant
		if occ then
			local who = Players:GetPlayerFromCharacter(occ.Parent)
			if who ~= player then
				-- Nur der Besitzer darf fahren
				local weld = seat:FindFirstChild("SeatWeld")
				if weld then
					weld:Destroy()
				end
				if who then
					notify(who, "Das ist nicht dein Auto!", "bad")
				end
				return
			end
			pcall(function()
				car.PrimaryPart:SetNetworkOwner(player)
			end)
		elseif mode == "test" and st.Drive == drive then
			task.delay(0.3, function()
				if st.Drive == drive and not seat.Occupant then
					endDrive(player, st)
				end
			end)
		end
	end)

	-- Spieler hineinsetzen
	local hum, char = getHumanoid(player)
	if hum and char and hum.Health > 0 then
		hum.Sit = false
		char:PivotTo(seat.CFrame + Vector3.new(0, 3, 0))
		task.wait(0.15)
		if seat.Parent and st.Drive == drive then
			seat:Sit(hum)
		end
	end
	return drive
end

RequestTestDrive.OnServerEvent:Connect(function(player)
	local st = States[player]
	if not st or not st.Plot then
		return
	end
	local lt = st.LastTuned
	if not lt or lt.Used or os.clock() > lt.Expires then
		notify(player, "Gerade ist keine Probefahrt möglich.", "bad")
		return
	end
	if st.Job then
		notify(player, "Erst das Tuning beenden.", "bad")
		return
	end
	lt.Used = true
	notify(player, "🏁 Probefahrt! Fahr eine Runde auf der Teststrecke (W/A/S/D).", "good")
	local drive = spawnDrivable(player, st, lt.Def, lt.Hp, World.TrackStart(st.Plot.Index), "test")
	drive.Tip = lt.Tip
end)

RequestCompanyCar.OnServerEvent:Connect(function(player)
	local st = States[player]
	if not st or not st.Plot then
		return
	end
	if st.Drive and st.Drive.Mode == "test" then
		notify(player, "Erst die Probefahrt beenden.", "bad")
		return
	end
	local now = os.clock()
	if st.LastCarRequest and now - st.LastCarRequest < 3 then
		return
	end
	st.LastCarRequest = now
	local hp = Config.CompanyCar.Hp + 120 * (maxStage(st) - 1)
	spawnDrivable(player, st, Config.CompanyCar, hp, st.Plot.CarSpot, "company")
end)

EndDrive.OnServerEvent:Connect(function(player)
	local st = States[player]
	if not st or not st.Drive then
		return
	end
	if st.Drive.Mode == "test" then
		endDrive(player, st)
	else
		local hum = getHumanoid(player)
		if hum then
			hum.Sit = false
		end
	end
end)

------------------------------------------------------------------------
-- Robux-Shop (Game Passes und Developer Products)
------------------------------------------------------------------------
local GOLD = Color3.fromRGB(255, 200, 40)

local function vipTag(char)
	local head = char:WaitForChild("Head", 5)
	if not head or head:FindFirstChild("VipTag") then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "VipTag"
	bb.Size = UDim2.fromOffset(120, 30)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.MaxDistance = 80
	bb.Adornee = head
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.GothamBlack
	tl.TextScaled = true
	tl.TextColor3 = GOLD
	tl.TextStrokeTransparency = 0
	tl.Text = "⭐ VIP"
	tl.Parent = bb
	bb.Parent = head
end

local function applyPass(player, st, key)
	if st.Passes[key] then
		return
	end
	st.Passes[key] = true
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		local plot = st.Plot
		if plot and plot.SignLabel then
			plot.SignLabel.Text = "⭐ " .. player.DisplayName .. "s Chiptuning ⭐"
			plot.SignLabel.TextColor3 = GOLD
		end
		if plot and plot.Strip then
			plot.Strip.Color = GOLD
		end
		if player.Character then
			task.spawn(vipTag, player.Character)
		end
	end
end

local function checkPasses(player, st)
	for _, pass in ipairs(Config.GamePasses) do
		if pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and owns and player.Parent then
				applyPass(player, st, pass.Key)
			end
		end
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local st = States[player]
	if not purchased or not st then
		return
	end
	for _, pass in ipairs(Config.GamePasses) do
		if pass.Id ~= 0 and pass.Id == passId then
			applyPass(player, st, pass.Key)
			notify(player, "Danke! " .. pass.Name .. " ist jetzt aktiv.", "good")
		end
	end
end)

local function findProduct(id)
	for _, prod in ipairs(Config.Products) do
		if prod.Id ~= 0 and prod.Id == id then
			return prod
		end
	end
	return nil
end

-- Wird von Roblox für jeden Kauf eines Developer Products aufgerufen
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local st = player and States[player]
	if not st then
		-- Spieler noch nicht geladen: Roblox versucht es später erneut
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receiptId = tostring(info.PurchaseId)
	if table.find(st.Data.Receipts, receiptId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local prod = findProduct(info.ProductId)
	if not prod then
		warn("[Chiptuning] Unbekanntes Produkt: " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	setMoney(st, st.Data.Money + prod.Money)
	table.insert(st.Data.Receipts, receiptId)
	while #st.Data.Receipts > 50 do
		table.remove(st.Data.Receipts, 1)
	end
	if st.CanSave and not saveData(player, st) then
		-- Speichern fehlgeschlagen: zurücknehmen, Roblox versucht es später erneut
		setMoney(st, st.Data.Money - prod.Money)
		local i = table.find(st.Data.Receipts, receiptId)
		if i then
			table.remove(st.Data.Receipts, i)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	notify(player, "Danke für deinen Kauf! +" .. Config.Format(prod.Money) .. " €", "good")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

------------------------------------------------------------------------
-- Spieler betreten / verlassen
------------------------------------------------------------------------
local function placeCharacter(player, char)
	local st = States[player]
	for _ = 1, 60 do
		if st and st.Plot then
			break
		end
		task.wait(0.25)
		st = States[player]
	end
	if not (st and st.Plot) then
		return
	end
	char:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.1)
	if char.Parent then
		char:PivotTo(st.Plot.Origin * CFrame.new(0, 4, 28))
		if st.Passes.VIP then
			vipTag(char)
		end
	end
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(char)
		placeCharacter(player, char)
	end)

	local index = nil
	for i = 1, Config.MaxPlots do
		if not usedPlots[i] then
			index = i
			break
		end
	end
	if not index then
		player:Kick("Alle Werkstätten auf diesem Server sind belegt. Bitte einen anderen Server wählen.")
		return
	end
	usedPlots[index] = player

	local data, canSave = loadData(player)
	if not player.Parent then
		usedPlots[index] = nil
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local money = Instance.new("IntValue")
	money.Name = "Geld"
	money.Value = data.Money
	money.Parent = leaderstats
	local rep = Instance.new("IntValue")
	rep.Name = "Ruf"
	rep.Value = data.Rep
	rep.Parent = leaderstats
	leaderstats.Parent = player

	for id in pairs(data.Upgrades) do
		player:SetAttribute("Upg_" .. id, true)
	end

	local st = {
		Data = data,
		CanSave = canSave,
		MoneyValue = money,
		RepValue = rep,
		Job = nil,
		Passes = {},
		NextCustomer = os.clock() + 3,
		NextAzubi = os.clock() + Config.AzubiInterval,
	}
	st.Plot = buildPlot(player, st, index)
	States[player] = st
	task.spawn(checkPasses, player, st)

	if player.Character then
		task.spawn(placeCharacter, player, player.Character)
	end

	if not canSave then
		notify(player, "Hinweis: Speichern ist aus (in Studio: API-Zugriff erlauben).", "bad")
	end
	notify(player, "Willkommen in deiner Chiptuning-Werkstatt! 🔧", "good")
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	local st = States[player]
	if not st then
		return
	end
	States[player] = nil
	if st.Drive then
		st.Drive.Car:Destroy()
		st.Drive = nil
	end
	saveData(player, st)
	if st.Plot then
		usedPlots[st.Plot.Index] = nil
		st.Plot.Model:Destroy()
	end
end)

game:BindToClose(function()
	for player, st in pairs(States) do
		task.spawn(saveData, player, st)
	end
	task.wait(3)
end)

------------------------------------------------------------------------
-- Hauptschleife: Kunden, Azubi, Autosave
------------------------------------------------------------------------
task.spawn(function()
	local lastSave = os.clock()
	while true do
		task.wait(1)
		local now = os.clock()
		for player, st in pairs(States) do
			if st.Plot then
				if now >= st.NextCustomer then
					for _, bay in ipairs(st.Plot.Bays) do
						if isBayUnlocked(st, bay.Index) and not bay.Car then
							spawnCustomer(player, st, bay)
							break
						end
					end
					local base = hasUpgrade(st, "Werbung") and Config.CustomerIntervalAds or Config.CustomerInterval
					if hasPass(st, "Turbo") then
						base *= Config.TurboMult
					end
					st.NextCustomer = now + base * (0.7 + math.random() * 0.6)
				end
				if st.Drive and st.Drive.Ends and now >= st.Drive.Ends then
					endDrive(player, st, "time")
				end
				if hasUpgrade(st, "Azubi") and now >= st.NextAzubi then
					st.NextAzubi = now + Config.AzubiInterval
					for _, bay in ipairs(st.Plot.Bays) do
						local c = bay.Car
						if c and c.Ready and not c.Busy and not c.Done then
							completeCar(player, st, bay, Config.Score.Good, true)
							break
						end
					end
				end
			end
		end
		if now - lastSave > 120 then
			lastSave = now
			for player, st in pairs(States) do
				task.spawn(saveData, player, st)
			end
		end
	end
end)

------------------------------------------------------------------------
-- Tag und Nacht
------------------------------------------------------------------------
task.spawn(function()
	local perSecond = 24 / (Config.DayLengthMinutes * 60)
	while true do
		local dt = task.wait(0.1)
		local t = Lighting.ClockTime
		local rate = (t < 6 or t > 19.5) and perSecond * 2 or perSecond -- Nächte gehen schneller vorbei
		Lighting.ClockTime = (t + rate * dt) % 24
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Bau-Helfer für Teile, Schilder und Bewegungen
-- ModuleScript "Util" in ServerScriptService

local RunService = game:GetService("RunService")

local Util = {}

-- Erstellt ein verankertes Part. Alle Felder in props werden gesetzt.
function Util.part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "Shape" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

function Util.wedge(props)
	local p = Instance.new("WedgePart")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

-- Text auf einer Fläche eines Parts
function Util.textGui(parentPart, face, text, color, bg, font)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 25
	sg.LightInfluence = 0
	sg.Parent = parentPart
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = bg and 0 or 1
	tl.BackgroundColor3 = bg or Color3.new(0, 0, 0)
	tl.Font = font or Enum.Font.GothamBlack
	tl.TextScaled = true
	tl.TextColor3 = color
	tl.Text = text
	tl.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.03, 0)
	pad.PaddingRight = UDim.new(0.03, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = tl
	return tl
end

-- Schwebendes Info-Schild
function Util.billboard(adornee, text, offsetY)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Info"
	bb.Size = UDim2.fromOffset(260, 64)
	bb.StudsOffset = Vector3.new(0, offsetY or 5, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Adornee = adornee
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
	tl.BackgroundTransparency = 0.25
	tl.TextColor3 = Color3.new(1, 1, 1)
	tl.Font = Enum.Font.GothamBold
	tl.TextScaled = true
	tl.Text = text
	tl.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = tl
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = tl
	bb.Parent = adornee
	return tl
end

function Util.light(parentPart, kind, props)
	local l = Instance.new(kind or "PointLight")
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parentPart
	return l
end

function Util.lookCF(pos, dir)
	return CFrame.lookAt(pos, pos + dir)
end

-- Bewegt ein Modell weich von A nach B (blockiert, bis fertig)
function Util.moveModel(model, fromCF, toCF, duration)
	local t0 = os.clock()
	while model.Parent do
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		local e = a < 0.5 and 2 * a * a or 1 - ((-2 * a + 2) ^ 2) / 2
		model:PivotTo(fromCF:Lerp(toCF, e))
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
end

return Util
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Die Spielwelt: Gelände, Licht, Straßen, Teststrecke, Bäume, Gebäude
-- ModuleScript "World" in ServerScriptService
--
-- Übersicht (von oben, Norden = -Z):
--   z = -750 … -150 : Teststrecke (Oval) mit Tribüne
--   z =  -45 …   45 : Werkstätten der Spieler (an der Werkstattstraße)
--   z =   50        : Werkstattstraße (Ost-West)
--   z =   80 …  200 : Läden und Gebäude
--   außen herum     : Landstraße als großer Rundkurs, See im Südosten, Berge am Rand

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Util = require(script.Parent:WaitForChild("Util"))
local part = Util.part

local World = {}

World.ROAD_Z = 50
World.PLOT_SPACING = 100
World.ROAD_TOP = 0.05 -- Oberkante der Straßen

local T = Config.Track
local SOUTH_Z = T.CenterZ + T.Radius
local NORTH_Z = T.CenterZ - T.Radius

local ASPHALT = Color3.fromRGB(52, 53, 58)

local folder

------------------------------------------------------------------------
-- Licht und Atmosphäre
------------------------------------------------------------------------
local function setProps(inst, props)
	for k, v in pairs(props) do
		local ok, err = pcall(function()
			inst[k] = v
		end)
		if not ok then
			warn("[World] " .. inst.ClassName .. "." .. k .. ": " .. tostring(err))
		end
	end
end

local function buildLighting()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	setProps(Lighting, {
		ClockTime = 14,
		GeographicLatitude = 45,
		Brightness = 2.6,
		Ambient = Color3.fromRGB(45, 45, 52),
		OutdoorAmbient = Color3.fromRGB(125, 125, 135),
		EnvironmentDiffuseScale = 1,
		EnvironmentSpecularScale = 1,
		GlobalShadows = true,
		ShadowSoftness = 0.15,
		ExposureCompensation = 0.1,
	})

	local atmo = Instance.new("Atmosphere")
	setProps(atmo, {
		Density = 0.28,
		Offset = 0.2,
		Color = Color3.fromRGB(199, 205, 215),
		Decay = Color3.fromRGB(110, 118, 132),
		Glare = 0.35,
		Haze = 1.4,
	})
	atmo.Parent = Lighting

	local sky = Instance.new("Sky")
	setProps(sky, { SunAngularSize = 14, MoonAngularSize = 9, StarCount = 3000 })
	sky.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	setProps(bloom, { Intensity = 0.45, Size = 24, Threshold = 1.3 })
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	setProps(cc, { Brightness = 0.02, Contrast = 0.1, Saturation = 0.15, TintColor = Color3.fromRGB(255, 250, 244) })
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	setProps(rays, { Intensity = 0.05, Spread = 0.6 })
	rays.Parent = Lighting

	local clouds = Instance.new("Clouds")
	setProps(clouds, { Cover = 0.55, Density = 0.6, Color = Color3.fromRGB(245, 245, 250) })
	clouds.Parent = workspace.Terrain
end

------------------------------------------------------------------------
-- Gelände (Terrain)
------------------------------------------------------------------------
local function buildTerrain()
	local terrain = workspace.Terrain
	pcall(function()
		terrain.Decoration = false -- keine Grashalme, die durch Böden wachsen
	end)
	-- Grundfläche, Oberkante y = 0
	terrain:FillBlock(CFrame.new(0, -6, 0), Vector3.new(2800, 12, 2800), Enum.Material.Grass)

	-- Berge ringsum
	local rng = Random.new(7)
	for i = 0, 39 do
		local a = i / 40 * math.pi * 2
		local r = 1280 + rng:NextNumber(-30, 60)
		local radius = rng:NextNumber(110, 190)
		local mat = (i % 3 == 0) and Enum.Material.Rock or Enum.Material.Grass
		terrain:FillBall(Vector3.new(math.cos(a) * r, -radius * 0.25, math.sin(a) * r), radius, mat)
		if mat == Enum.Material.Rock and radius > 150 then
			terrain:FillBall(Vector3.new(math.cos(a) * (r + 30), radius * 0.45, math.sin(a) * (r + 30)), radius * 0.45, Enum.Material.Snow)
		end
	end

	-- See mit Sandstrand im Südosten
	local lake = CFrame.new(650, 0, 430)
	terrain:FillBlock(lake * CFrame.new(0, -4, 0), Vector3.new(300, 8, 240), Enum.Material.Sand)
	terrain:FillBlock(lake * CFrame.new(0, -6, 0), Vector3.new(250, 12, 190), Enum.Material.Air)
	terrain:FillBlock(lake * CFrame.new(0, -8, 0), Vector3.new(250, 12, 190), Enum.Material.Water)
	terrain:FillBlock(lake * CFrame.new(0, -15, 0), Vector3.new(250, 2, 190), Enum.Material.Sand)
end

------------------------------------------------------------------------
-- Befestigte Flächen
------------------------------------------------------------------------
-- Entfernt das Gelände unter einer Fläche und setzt eine 4 Studs dicke Platte
-- ein. cf liegt auf Bodenhöhe (y = 0), top ist die Oberkante der Platte.
function World.Slab(cf, sizeX, sizeZ, top, color, material, name, parent)
	workspace.Terrain:FillBlock(cf * CFrame.new(0, 2, 0), Vector3.new(sizeX, 12, sizeZ), Enum.Material.Air)
	return part({
		Name = name or "Platte",
		Size = Vector3.new(sizeX, 4, sizeZ),
		CFrame = cf * CFrame.new(0, top - 2, 0),
		Color = color,
		Material = material,
		Parent = parent or folder,
	})
end

------------------------------------------------------------------------
-- Straßen
------------------------------------------------------------------------
local roadCount = 0

-- Gerades Straßenstück von a nach b (Vector3, y egal)
local function road(a, b, width, dashes, color)
	roadCount += 1
	local top = World.ROAD_TOP + roadCount * 0.004 -- gegen Flimmern bei Überlappung
	local pa = Vector3.new(a.X, 0, a.Z)
	local pb = Vector3.new(b.X, 0, b.Z)
	local len = (pb - pa).Magnitude
	local mid = (pa + pb) / 2
	local cf = CFrame.lookAt(mid, pb)
	World.Slab(cf, width, len, top, color or ASPHALT, Enum.Material.Asphalt, "Strasse")
	-- Bordsteine
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Bordstein",
			Size = Vector3.new(0.8, 0.3, len),
			CFrame = cf * CFrame.new(side * (width / 2 + 0.4), top - 0.05, 0),
			Color = Color3.fromRGB(165, 165, 168),
			Material = Enum.Material.Concrete,
			CanCollide = false,
			Parent = folder,
		})
	end
	if dashes then
		local n = math.floor(len / 20)
		for i = 0, n - 1 do
			local z = -len / 2 + 10 + i * 20
			part({
				Name = "Markierung",
				Size = Vector3.new(0.6, 0.05, 8),
				CFrame = cf * CFrame.new(0, top + 0.02, z),
				Color = Color3.fromRGB(235, 235, 235),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
	end
end

local function buildRoads()
	local z = World.ROAD_Z
	road(Vector3.new(-950, 0, z), Vector3.new(950, 0, z), 22, true) -- Werkstattstraße
	road(Vector3.new(0, 0, z - 11), Vector3.new(0, 0, SOUTH_Z + 14), 18, true) -- Zufahrt Teststrecke
	-- Landstraße (großer Rundkurs)
	road(Vector3.new(-700, 0, 260), Vector3.new(700, 0, 260), 20, true)
	road(Vector3.new(-700, 0, -780), Vector3.new(700, 0, -780), 20, true)
	road(Vector3.new(-700, 0, -790), Vector3.new(-700, 0, 270), 20, true)
	road(Vector3.new(700, 0, -790), Vector3.new(700, 0, 270), 20, true)
	-- Verbindung zur Tribüne / zum See
	road(Vector3.new(560, 0, 270), Vector3.new(560, 0, 300), 14, false)
end

------------------------------------------------------------------------
-- Teststrecke
------------------------------------------------------------------------
local function curb(cf, i, length)
	part({
		Name = "Curb",
		Size = Vector3.new(1.6, 0.25, length),
		CFrame = cf,
		Color = (i % 2 == 0) and Color3.fromRGB(210, 30, 30) or Color3.fromRGB(240, 240, 240),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function buildTrack()
	local top = 0.09
	local hl, r, w = T.HalfLength, T.Radius, T.Width
	local cz = T.CenterZ
	local trackColor = Color3.fromRGB(44, 45, 50)

	-- Geraden
	for _, zz in ipairs({ SOUTH_Z, NORTH_Z }) do
		World.Slab(CFrame.new(0, 0, zz), hl * 2, w, top, trackColor, Enum.Material.Asphalt, "Gerade")
		for _, side in ipairs({ -1, 1 }) do
			part({
				Name = "Randlinie",
				Size = Vector3.new(hl * 2, 0.05, 0.7),
				CFrame = CFrame.new(0, top + 0.02, zz + side * (w / 2 - 1)),
				Color = Color3.new(1, 1, 1),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
	end

	-- Kurven (Halbkreise) aus Segmenten
	local N = 30
	for _, side in ipairs({ 1, -1 }) do
		local cx = side * hl
		local a0 = side == 1 and -math.pi / 2 or math.pi / 2
		for k = 0, N - 1 do
			local t0 = a0 + k / N * math.pi
			local t1 = a0 + (k + 1) / N * math.pi
			local p0 = Vector3.new(cx + math.cos(t0) * r, 0, cz + math.sin(t0) * r)
			local p1 = Vector3.new(cx + math.cos(t1) * r, 0, cz + math.sin(t1) * r)
			local mid = (p0 + p1) / 2
			local cf = CFrame.lookAt(mid, p1)
			local len = (p1 - p0).Magnitude
			-- Außen ist das Segment länger als innen: Länge an Außenkante anpassen
			local outerLen = len * (r + w / 2) / r + 0.4
			World.Slab(cf, w, outerLen, top - 0.001 * (k % 2), trackColor, Enum.Material.Asphalt, "Kurve")
			-- Kiesbett außen bis zur Mauer
			local radialMid = (mid - Vector3.new(cx, 0, cz)).Unit
			local gravelR = r + w / 2 + 7.5
			local gpos = Vector3.new(cx, 0, cz) + radialMid * gravelR
			World.Slab(
				CFrame.lookAt(gpos, gpos + cf.LookVector),
				12,
				len * gravelR / r + 0.6,
				0.06 - 0.001 * (k % 2),
				Color3.fromRGB(196, 180, 150),
				Enum.Material.Pebble,
				"Kiesbett"
			)
			-- Curbs innen und außen
			local radial = (mid - Vector3.new(cx, 0, cz)).Unit
			for _, off in ipairs({ r - w / 2 - 0.8, r + w / 2 + 0.8 }) do
				local pos = Vector3.new(cx, 0, cz) + radial * off
				local scale = off / r
				local ccf = CFrame.lookAt(pos, pos + cf.LookVector) * CFrame.new(0, 0.12, 0)
				for j = 0, 1 do
					curb(ccf * CFrame.new(0, 0, (j - 0.5) * len * scale / 2), k * 2 + j, len * scale / 2 + 0.05)
				end
			end
			-- Betonmauer außen
			local wallPos = Vector3.new(cx, 0, cz) + radial * (r + w / 2 + 14)
			part({
				Name = "Mauer",
				Size = Vector3.new(1.5, 3, len * (r + w / 2 + 14) / r + 0.3),
				CFrame = CFrame.lookAt(wallPos, wallPos + cf.LookVector) * CFrame.new(0, 1.5, 0),
				Color = (k % 2 == 0) and Color3.fromRGB(230, 230, 230) or Color3.fromRGB(200, 40, 40),
				Material = Enum.Material.Concrete,
				Parent = folder,
			})
		end
	end

	-- Start/Ziel: Schachbrett und Portal
	for row = 0, 1 do
		for i = 0, w / 2 - 1 do
			part({
				Name = "Zielinie",
				Size = Vector3.new(2, 0.05, 2),
				CFrame = CFrame.new(-1 + row * 2, top + 0.03, SOUTH_Z - w / 2 + 1 + i * 2),
				Color = ((i + row) % 2 == 0) and Color3.new(1, 1, 1) or Color3.new(0.05, 0.05, 0.05),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Portal",
			Size = Vector3.new(1.5, 18, 1.5),
			CFrame = CFrame.new(0, 9, SOUTH_Z + side * (w / 2 + 2)),
			Color = Color3.fromRGB(30, 30, 34),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	local beam = part({
		Name = "PortalSchild",
		Size = Vector3.new(1.5, 4, w + 6),
		CFrame = CFrame.new(0, 17, SOUTH_Z),
		Color = Color3.fromRGB(20, 20, 24),
		Parent = folder,
	})
	Util.textGui(beam, Enum.NormalId.Left, "🏁 TESTSTRECKE 🏁", Color3.fromRGB(255, 140, 0), Color3.fromRGB(20, 20, 24))
	Util.textGui(beam, Enum.NormalId.Right, "🏁 TESTSTRECKE 🏁", Color3.fromRGB(255, 140, 0), Color3.fromRGB(20, 20, 24))

	-- Tribüne innerhalb des Ovals, mit Blick auf die Start-Ziel-Gerade
	local standZ = SOUTH_Z - w / 2 - 22
	for tier = 0, 5 do
		part({
			Name = "Tribuene",
			Size = Vector3.new(120, 1.5 + tier * 1.5, 4),
			CFrame = CFrame.new(0, (1.5 + tier * 1.5) / 2, standZ - tier * 4),
			Color = (tier % 2 == 0) and Color3.fromRGB(60, 90, 160) or Color3.fromRGB(50, 75, 140),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
	end
	part({
		Name = "TribuenenDach",
		Size = Vector3.new(124, 1, 30),
		CFrame = CFrame.new(0, 18, standZ - 10) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Color3.fromRGB(235, 235, 240),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	for _, x in ipairs({ -58, 0, 58 }) do
		part({
			Name = "DachStuetze",
			Size = Vector3.new(1.2, 18, 1.2),
			CFrame = CFrame.new(x, 9, standZ - 22),
			Color = Color3.fromRGB(80, 80, 85),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	-- Flutlichtmasten
	for _, p in ipairs({ Vector3.new(-150, 0, SOUTH_Z + 30), Vector3.new(150, 0, SOUTH_Z + 30), Vector3.new(-150, 0, NORTH_Z - 30), Vector3.new(150, 0, NORTH_Z - 30) }) do
		part({ Name = "Mast", Size = Vector3.new(1.5, 40, 1.5), CFrame = CFrame.new(p + Vector3.new(0, 20, 0)), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Metal, Parent = folder })
		local head = part({
			Name = "Flutlicht",
			Size = Vector3.new(8, 3, 2),
			CFrame = CFrame.lookAt(p + Vector3.new(0, 40, 0), Vector3.new(p.X, 0, T.CenterZ)),
			Color = Color3.fromRGB(255, 250, 235),
			Material = Enum.Material.Neon,
			Parent = folder,
		})
		Util.light(head, "SpotLight", { Face = Enum.NormalId.Front, Range = 60, Brightness = 3, Angle = 90 })
	end
end

------------------------------------------------------------------------
-- Fahrerlager an der Start-Ziel-Geraden
------------------------------------------------------------------------
local function buildPaddock()
	local z0 = SOUTH_Z + T.Width / 2 - 1 -- direkt an der Strecke
	local depth = 70
	local cz = z0 + depth / 2
	World.Slab(CFrame.new(0, 0, cz), 380, depth, 0.07, Color3.fromRGB(60, 61, 66), Enum.Material.Asphalt, "Fahrerlager")
	-- Boxenmauer mit Lücke für die Zufahrt
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "Boxenmauer",
			Size = Vector3.new(170, 1.6, 1),
			CFrame = CFrame.new(side * 105, 0.85, z0 + 2),
			Color = Color3.fromRGB(235, 235, 235),
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
	end
	-- Parkbuchten
	for x = -176, 176, 10 do
		if math.abs(x) > 24 then
			part({
				Name = "Parklinie",
				Size = Vector3.new(0.4, 0.05, 14),
				CFrame = CFrame.new(x, 0.1, z0 + depth - 9),
				Color = Color3.new(1, 1, 1),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
	end
	-- Boxengebäude
	local box = part({
		Name = "Boxengebaeude",
		Size = Vector3.new(120, 12, 16),
		CFrame = CFrame.new(-120, 6, z0 + depth + 8),
		Color = Color3.fromRGB(230, 232, 236),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	Util.textGui(box, Enum.NormalId.Front, "BOXEN · PIT LANE", Color3.fromRGB(255, 140, 0), Color3.fromRGB(25, 25, 30))
	for i = 0, 4 do
		part({
			Name = "Boxentor",
			Size = Vector3.new(18, 8, 0.3),
			CFrame = CFrame.new(-168 + i * 24, 4.2, z0 + depth - 0.1),
			Color = Color3.fromRGB(40, 42, 48),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
end

------------------------------------------------------------------------
-- Straßenlaternen
------------------------------------------------------------------------
local function lamp(pos, facing)
	local pole = Color3.fromRGB(45, 48, 52)
	part({ Name = "Mast", Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 0.6, 0.6), CFrame = CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = pole, Material = Enum.Material.Metal, Parent = folder })
	part({ Name = "Arm", Size = Vector3.new(0.35, 0.35, 4), CFrame = CFrame.lookAt(pos + Vector3.new(0, 14, 0), pos + Vector3.new(0, 14, 0) + facing) * CFrame.new(0, 0, -2), Color = pole, Material = Enum.Material.Metal, Parent = folder })
	local head = part({
		Name = "Leuchte",
		Size = Vector3.new(1.6, 0.35, 2.4),
		CFrame = CFrame.lookAt(pos + Vector3.new(0, 13.8, 0) + facing * 4, pos + Vector3.new(0, 13.8, 0) + facing * 5),
		Color = Color3.fromRGB(255, 236, 200),
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	Util.light(head, "SpotLight", { Face = Enum.NormalId.Bottom, Range = 30, Brightness = 2.2, Angle = 120, Color = Color3.fromRGB(255, 225, 180) })
end

local function buildLamps()
	for x = -900, 900, 60 do
		lamp(Vector3.new(x, 0, World.ROAD_Z + 14), -Vector3.zAxis)
	end
	for z = SOUTH_Z + 40, -60, 50 do
		lamp(Vector3.new(14, 0, z), -Vector3.xAxis)
	end
end

------------------------------------------------------------------------
-- Gebäude an der Werkstattstraße (Südseite)
------------------------------------------------------------------------
local SHOPS = {
	{ "Reifen Express", Color3.fromRGB(40, 40, 45), Color3.fromRGB(255, 200, 0) },
	{ "Tankstelle", Color3.fromRGB(230, 230, 235), Color3.fromRGB(220, 30, 30) },
	{ "Lackiererei Glanz", Color3.fromRGB(70, 90, 120), Color3.fromRGB(120, 220, 255) },
	{ "Autohaus Nord", Color3.fromRGB(235, 235, 240), Color3.fromRGB(30, 90, 200) },
	{ "Café Ladedruck", Color3.fromRGB(120, 80, 60), Color3.fromRGB(255, 220, 160) },
	{ "Teile-Lager", Color3.fromRGB(150, 150, 155), Color3.fromRGB(255, 140, 0) },
	{ "Waschanlage", Color3.fromRGB(60, 140, 200), Color3.fromRGB(255, 255, 255) },
	{ "Felgen-Shop", Color3.fromRGB(30, 30, 35), Color3.fromRGB(200, 200, 210) },
	{ "Motorsport Halle", Color3.fromRGB(180, 30, 30), Color3.fromRGB(255, 255, 255) },
	{ "Bürogebäude", Color3.fromRGB(190, 195, 200), Color3.fromRGB(80, 200, 255) },
}

local function building(x, width, depth, height, name, wallColor, signColor, rng)
	local zFront = World.ROAD_Z + 30
	local cz = zFront + depth / 2
	local wallMat = rng:NextNumber() < 0.4 and Enum.Material.Brick or Enum.Material.Concrete
	part({ Name = name, Size = Vector3.new(width, height, depth), CFrame = CFrame.new(x, height / 2, cz), Color = wallColor, Material = wallMat, Parent = folder })
	part({ Name = "Dachkante", Size = Vector3.new(width + 1, 1, depth + 1), CFrame = CFrame.new(x, height + 0.5, cz), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Concrete, Parent = folder })
	-- Fenster an der Vorderseite (zeigt zur Straße, -Z)
	local cols = math.floor((width - 6) / 7)
	local rows = math.floor((height - 12) / 8)
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local wx = x - (cols - 1) * 3.5 + c * 7
			local wy = 12 + r * 8 + 2
			local lit = rng:NextNumber() < 0.35
			part({
				Name = "Fenster",
				Size = Vector3.new(4.5, 4.5, 0.3),
				CFrame = CFrame.new(wx, wy, zFront - 0.1),
				Color = lit and Color3.fromRGB(255, 225, 160) or Color3.fromRGB(35, 50, 70),
				Material = lit and Enum.Material.Neon or Enum.Material.Glass,
				Reflectance = lit and 0 or 0.3,
				Parent = folder,
			})
		end
	end
	-- Eingang / Schaufenster unten
	part({ Name = "Schaufenster", Size = Vector3.new(width * 0.6, 6, 0.3), CFrame = CFrame.new(x, 3.5, zFront - 0.1), Color = Color3.fromRGB(40, 60, 80), Material = Enum.Material.Glass, Transparency = 0.2, Reflectance = 0.3, Parent = folder })
	local sign = part({ Name = "Ladenschild", Size = Vector3.new(math.min(width - 4, 40), 4, 0.6), CFrame = CFrame.new(x, 8.5, zFront - 0.4), Color = Color3.fromRGB(15, 15, 18), Parent = folder })
	Util.textGui(sign, Enum.NormalId.Front, name, signColor, Color3.fromRGB(15, 15, 18))
	-- Gehweg
	World.Slab(CFrame.new(x, 0, zFront - 5), width + 10, 10, 0.4, Color3.fromRGB(175, 175, 178), Enum.Material.Pavement, "Gehweg")
end

local function buildTown()
	local rng = Random.new(3)
	local x = -560
	local i = 0
	while x < 560 do
		local width = rng:NextInteger(40, 64)
		local cx = x + width / 2
		if math.abs(cx) > width / 2 + 30 then -- Platz für den Spawn in der Mitte lassen
			i += 1
			local shop = SHOPS[(i - 1) % #SHOPS + 1]
			building(cx, width, rng:NextInteger(40, 70), rng:NextInteger(22, 46), shop[1], shop[2], shop[3], rng)
		end
		x += width + rng:NextInteger(14, 30)
	end
end

------------------------------------------------------------------------
-- Bäume
------------------------------------------------------------------------
local BLOCKED = {
	-- {minX, maxX, minZ, maxZ}
	{ -960, 960, 20, 80 }, -- Werkstattstraße + Laternen
	{ -330, 330, -50, 45 }, -- Werkstätten
	{ -25, 25, SOUTH_Z, 60 }, -- Zufahrt
	{ -T.HalfLength - T.Radius - 40, T.HalfLength + T.Radius + 40, NORTH_Z - 50, SOUTH_Z + 95 }, -- Teststrecke + Fahrerlager
	{ -600, 600, 75, 200 }, -- Gebäude
	{ -720, 720, 245, 275 }, -- Landstraße Süd
	{ -720, 720, -795, -765 },
	{ -715, -685, -795, 275 },
	{ 685, 715, -795, 275 },
	{ 480, 820, 290, 570 }, -- See
}

local function isFree(x, z)
	for _, b in ipairs(BLOCKED) do
		if x > b[1] and x < b[2] and z > b[3] and z < b[4] then
			return false
		end
	end
	return math.sqrt(x * x + z * z) < 1020
end

local function tree(pos, rng)
	local trunkH = rng:NextNumber(7, 11)
	part({
		Name = "Stamm",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkH, 1.4, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(95, 70, 50),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	if rng:NextNumber() < 0.35 then
		-- Nadelbaum: gestapelte Scheiben
		for i = 0, 3 do
			local d = 11 - i * 2.5
			part({
				Name = "Nadeln",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(2.6, d, d),
				CFrame = CFrame.new(pos + Vector3.new(0, trunkH - 2 + i * 2.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(35, 80 + i * 5, 45),
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = folder,
			})
		end
	else
		local g = rng:NextInteger(95, 140)
		for _ = 1, 3 do
			local s = rng:NextNumber(7, 11)
			part({
				Name = "Krone",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(s, s, s),
				CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-2, 2), trunkH + rng:NextNumber(0, 3), rng:NextNumber(-2, 2))),
				Color = Color3.fromRGB(55, g, 50),
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = folder,
			})
		end
	end
end

local function buildTrees()
	local rng = Random.new(42)
	local placed = 0
	local tries = 0
	while placed < 380 and tries < 5000 do
		tries += 1
		local x = rng:NextNumber(-1020, 1020)
		local z = rng:NextNumber(-1020, 1020)
		if isFree(x, z) then
			tree(Vector3.new(x, 0, z), rng)
			placed += 1
		end
	end
	-- Allee entlang der Zufahrt zur Teststrecke
	for z = SOUTH_Z + 110, -60, 40 do
		tree(Vector3.new(-22, 0, z), rng)
		tree(Vector3.new(26, 0, z + 20), rng)
	end
end

------------------------------------------------------------------------
-- Aufbau
------------------------------------------------------------------------
function World.Build()
	folder = Instance.new("Folder")
	folder.Name = "Welt"
	folder.Parent = workspace

	buildLighting()
	buildTerrain()
	buildRoads()
	buildTrack()
	buildPaddock()
	buildLamps()
	buildTown()
	buildTrees()

	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Name = "Spawn"
	spawnLoc.Anchored = true
	spawnLoc.Size = Vector3.new(12, 1, 12)
	World.Slab(CFrame.new(0, 0, World.ROAD_Z + 30), 24, 22, 0.4, Color3.fromRGB(175, 175, 178), Enum.Material.Pavement, "SpawnPlatz")
	spawnLoc.CFrame = CFrame.new(0, 0.5, World.ROAD_Z + 30)
	spawnLoc.Neutral = true
	spawnLoc.Duration = 0
	spawnLoc.Material = Enum.Material.SmoothPlastic
	spawnLoc.Color = Color3.fromRGB(255, 140, 0)
	spawnLoc.Parent = folder

	local vehicles = Instance.new("Folder")
	vehicles.Name = "Fahrzeuge"
	vehicles.Parent = workspace
	World.Vehicles = vehicles
	World.Folder = folder
end

-- Startplatz auf der Start-Ziel-Geraden (Fahrtrichtung +X)
function World.TrackStart(index)
	local x = -60 - (index - 1) * 18
	local z = SOUTH_Z + ((index % 2 == 0) and 6 or -6)
	local pos = Vector3.new(x, 0.09 + 0.9, z)
	return CFrame.lookAt(pos, pos + Vector3.xAxis)
end

return World
