<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX00000002"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Chiptuning-Firma: gemeinsame Einstellungen (Server und Client)
-- ModuleScript "Config" in ReplicatedStorage

local Config = {}

Config.StartMoney = 300
Config.DataStoreName = "ChiptuningFirma_v1"
Config.MaxPlots = 6 -- in den Spieleinstellungen "Max Players" auf 6 stellen

-- Die drei Kennfelder, die beim Tunen nacheinander abgestimmt werden
Config.MapNames = { "Zündzeitpunkt", "Ladedruck", "Einspritzmenge" }

Config.Stages = {
	{ Name = "Stage 1", PowerGain = 0.20, TorqueGain = 0.25, BasePay = 120, SpeedMult = 1.00 },
	{ Name = "Stage 2", PowerGain = 0.35, TorqueGain = 0.40, BasePay = 320, SpeedMult = 1.25 },
	{ Name = "Stage 3", PowerGain = 0.55, TorqueGain = 0.60, BasePay = 800, SpeedMult = 1.50 },
}

-- Kundenautos (fiktive Modelle). MinRep = ab welchem Ruf der Kunde kommt
Config.Cars = {
	{ Name = "Stadtflitzer 1.0 Turbo", Hp = 95, Nm = 175, PayMult = 0.7, MinRep = 0, Color = Color3.fromRGB(200, 200, 205) },
	{ Name = "Kompakt 1.4 Turbo", Hp = 150, Nm = 250, PayMult = 0.9, MinRep = 0, Color = Color3.fromRGB(30, 80, 160) },
	{ Name = "Familienkombi 2.0 Diesel", Hp = 150, Nm = 340, PayMult = 1.0, MinRep = 0, Color = Color3.fromRGB(40, 40, 45) },
	{ Name = "Hot Hatch GTX", Hp = 245, Nm = 370, PayMult = 1.2, MinRep = 10, Color = Color3.fromRGB(190, 20, 30) },
	{ Name = "Limousine 3.0 Diesel", Hp = 286, Nm = 650, PayMult = 1.4, MinRep = 25, Color = Color3.fromRGB(20, 40, 90) },
	{ Name = "Sportkombi 2.9 V6", Hp = 450, Nm = 600, PayMult = 1.8, MinRep = 50, Color = Color3.fromRGB(80, 90, 95) },
	{ Name = "Sportcoupé 3.8 Turbo", Hp = 580, Nm = 750, PayMult = 2.5, MinRep = 100, Color = Color3.fromRGB(240, 180, 0) },
	{ Name = "Supersportler V12", Hp = 780, Nm = 720, PayMult = 3.5, MinRep = 200, Color = Color3.fromRGB(10, 150, 80) },
}

-- Upgrades im Werkstatt-Shop (Reihenfolge = Anzeige im Shop)
Config.Upgrades = {
	{ Id = "Bay2", Name = "2. Hebebühne", Price = 800, Desc = "Zwei Kunden gleichzeitig bedienen." },
	{ Id = "Stage2", Name = "Stage-2-Software", Price = 2000, Desc = "Kunden buchen jetzt auch Stage 2 – mehr Geld pro Auftrag." },
	{ Id = "Laptop", Name = "Profi-Tuning-Laptop", Price = 2500, Desc = "Die grüne Zone beim Abstimmen wird breiter." },
	{ Id = "Werbung", Name = "Werbung schalten", Price = 3500, Desc = "Kunden kommen doppelt so oft." },
	{ Id = "Bay3", Name = "3. Hebebühne", Price = 4000, Requires = "Bay2", Desc = "Drei Kunden gleichzeitig." },
	{ Id = "Dyno", Name = "Leistungsprüfstand", Price = 6000, Desc = "+25 % Bezahlung. Jedes Auto kommt nach dem Tunen auf die Rolle." },
	{ Id = "Azubi", Name = "Azubi einstellen", Price = 9000, Desc = "Tunt wartende Autos automatisch (Ergebnis: okay)." },
	{ Id = "Bay4", Name = "4. Hebebühne", Price = 12000, Requires = "Bay3", Desc = "Vier Kunden gleichzeitig." },
	{ Id = "Stage3", Name = "Stage-3-Software", Price = 15000, Requires = "Stage2", Desc = "Die großen Aufträge: Stage 3 mit Top-Bezahlung." },
}

------------------------------------------------------------------------
-- ROBUX-SHOP
-- Die Artikel im Creator Hub anlegen (Spiel → Monetization → Passes
-- bzw. Developer Products) und hier die IDs eintragen.
-- Id = 0 heißt: noch nicht eingerichtet, der Knopf zeigt "Bald verfügbar".
-- Den Robux-Preis legst du im Creator Hub fest; das Spiel liest ihn
-- automatisch aus. PriceHint wird nur angezeigt, solange das nicht klappt.
------------------------------------------------------------------------
Config.GamePasses = {
	{ Key = "DoubleMoney", Id = 0, PriceHint = 199, Name = "💰 Doppeltes Geld", Desc = "Jeder Auftrag zahlt doppelt – für immer." },
	{ Key = "VIP", Id = 0, PriceHint = 149, Name = "⭐ VIP-Werkstatt", Desc = "Goldenes Firmenschild, VIP-Titel über dem Kopf und +10 % Geld." },
	{ Key = "Turbo", Id = 0, PriceHint = 99, Name = "🚀 Turbo-Kundschaft", Desc = "Kunden kommen doppelt so schnell (zusätzlich zur Werbung)." },
}

Config.Products = {
	{ Key = "Cash5k", Id = 0, PriceHint = 49, Money = 5000, Name = "Geldpaket S", Desc = "+5.000 € sofort aufs Firmenkonto." },
	{ Key = "Cash25k", Id = 0, PriceHint = 149, Money = 25000, Name = "Geldpaket L", Desc = "+25.000 € sofort aufs Firmenkonto." },
}

Config.DoubleMoneyMult = 2
Config.VipMult = 1.1
Config.TurboMult = 0.5 -- Kundenabstand wird halbiert

------------------------------------------------------------------------

-- Teststrecke (Oval): zwei Geraden + zwei Halbkreise
Config.Track = { CenterZ = -450, HalfLength = 250, Radius = 150, Width = 30 }

-- Fahren
Config.TestDriveSeconds = 75 -- Dauer einer Probefahrt
Config.TestDriveTip = 0.15 -- Trinkgeld-Anteil nach der Probefahrt
Config.TestDriveMinSeconds = 15 -- so lange muss man fahren für Trinkgeld
Config.CompanyCar = { Name = "Firmenwagen", Hp = 220, Nm = 350, Color = Color3.fromRGB(255, 140, 0) }
Config.DayLengthMinutes = 24 -- ein Tag-Nacht-Zyklus

-- Fahrwerte aus der Leistung (Studs pro Sekunde)
function Config.DriveStats(hp)
	return {
		TopSpeed = 60 + hp * 0.13,
		Accel = 18 + hp * 0.06,
	}
end

-- Studs/s -> km/h (gefühlt passend zur Roblox-Größe)
Config.KmhFactor = 1.25

Config.CustomerInterval = 14 -- Sekunden zwischen Kunden
Config.CustomerIntervalAds = 7 -- mit Werbung
Config.ZoneWidth = 0.16 -- Breite der grünen Zone (Anteil des Balkens)
Config.ZoneWidthLaptop = 0.26
Config.AzubiInterval = 20
Config.DynoBonus = 1.25

Config.Score = { Perfect = 1, Good = 0.6, Bad = 0.15 }

function Config.GetUpgrade(id)
	for _, up in ipairs(Config.Upgrades) do
		if up.Id == id then
			return up
		end
	end
	return nil
end

function Config.GetPassByKey(key)
	for _, p in ipairs(Config.GamePasses) do
		if p.Key == key then
			return p
		end
	end
	return nil
end

-- Bewertet, wo die Nadel gestoppt wurde
function Config.Rate(pos, center, width)
	local d = math.abs(pos - center)
	if d <= width / 2 then
		return "Perfect"
	elseif d <= width then
		return "Good"
	end
	return "Bad"
end

-- 12345 -> "12.345"
function Config.Format(n)
	local s = tostring(math.floor(n))
	local neg = s:sub(1, 1) == "-"
	if neg then
		s = s:sub(2)
	end
	local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if out:sub(1, 1) == "." then
		out = out:sub(2)
	end
	return (neg and "-" or "") .. out
end

return Config
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX00000007"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Cars</string><ProtectedString name="Source"><![CDATA[-- Automodelle: Ausstellungsautos (verankert) und fahrbare Autos
-- ModuleScript "Cars" in ServerScriptService
--
-- Koordinaten relativ zur Karosseriemitte. Die Karosseriemitte liegt 1.7 Studs
-- über dem Boden, die Front zeigt nach -Z.

local Util = require(script.Parent:WaitForChild("Util"))
local part, wedge = Util.part, Util.wedge

local Cars = {}

Cars.BODY_HEIGHT = 1.7 -- Karosseriemitte über Boden
Cars.CHASSIS_HEIGHT = 0.9 -- Mitte des Fahrgestells (fahrbares Auto) über Boden

local TIRE = Color3.fromRGB(25, 25, 27)
local TRIM = Color3.fromRGB(30, 30, 34)
local CHROME = Color3.fromRGB(200, 202, 210)
local GLASS = Color3.fromRGB(20, 28, 40)

local function buildVisual(def, m, convertible)
	local paint = def.Color
	local function lack(name, size, cf)
		return part({
			Name = name,
			Size = size,
			CFrame = cf,
			Color = paint,
			Material = Enum.Material.SmoothPlastic,
			Reflectance = 0.12,
			CanCollide = false,
			Parent = m,
		})
	end
	local function trim(name, size, cf, color, material)
		return part({
			Name = name,
			Size = size,
			CFrame = cf,
			Color = color or TRIM,
			Material = material or Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = m,
		})
	end

	-- Karosserie
	lack("Karosserie", Vector3.new(6, 1.0, 12), CFrame.new(0, -0.3, 0))
	lack("Schulter", Vector3.new(5.8, 0.6, 11.6), CFrame.new(0, 0.5, 0))
	local hood = wedge({
		Name = "Haube",
		Size = Vector3.new(5.6, 0.35, 2.6),
		CFrame = CFrame.new(0, 0.97, -4.4),
		Color = paint,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.12,
		CanCollide = false,
		Parent = m,
	})
	hood.Name = "Haube"

	-- Fahrgastzelle
	if convertible then
		part({
			Name = "Frontscheibe",
			Size = Vector3.new(5.0, 1.2, 0.15),
			CFrame = CFrame.new(0, 1.3, -1.9) * CFrame.Angles(math.rad(30), 0, 0),
			Color = GLASS,
			Material = Enum.Material.Glass,
			Transparency = 0.45,
			CanCollide = false,
			Parent = m,
		})
		for _, x in ipairs({ -1.3, 1.3 }) do
			trim("Sitz", Vector3.new(1.6, 1.5, 0.4), CFrame.new(x, 1.35, 1.6), Color3.fromRGB(20, 20, 22), Enum.Material.Fabric)
		end
		part({
			Name = "Lenkrad",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 1.0, 1.0),
			CFrame = CFrame.new(-1.3, 1.25, -0.9) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(-25)),
			Color = Color3.fromRGB(15, 15, 15),
			CanCollide = false,
			Parent = m,
		})
	else
		part({
			Name = "Scheiben",
			Size = Vector3.new(5.0, 1.3, 5.4),
			CFrame = CFrame.new(0, 1.45, 0.9),
			Color = GLASS,
			Material = Enum.Material.Glass,
			Transparency = 0.25,
			Reflectance = 0.2,
			CanCollide = false,
			Parent = m,
		})
		lack("Dach", Vector3.new(4.8, 0.2, 4.2), CFrame.new(0, 2.15, 1.1))
	end

	-- Stoßstangen, Grill, Schweller, Spiegel
	trim("FrontStoss", Vector3.new(6.1, 0.55, 0.5), CFrame.new(0, -0.55, -6.1))
	trim("HeckStoss", Vector3.new(6.1, 0.55, 0.5), CFrame.new(0, -0.55, 6.1))
	trim("Grill", Vector3.new(3.4, 0.45, 0.1), CFrame.new(0, 0.05, -6.03), Color3.fromRGB(12, 12, 14))
	for _, x in ipairs({ -3.05, 3.05 }) do
		trim("Schweller", Vector3.new(0.15, 0.3, 6.4), CFrame.new(x, -0.7, 0))
		lack("Spiegel", Vector3.new(0.5, 0.3, 0.4), CFrame.new(x * 1.02, 1.0, -1.6))
	end

	-- Lichter
	local lights = {}
	for _, x in ipairs({ -2.15, 2.15 }) do
		local hl = part({
			Name = "Scheinwerfer",
			Size = Vector3.new(1.3, 0.35, 0.15),
			CFrame = CFrame.new(x, 0.35, -6.0),
			Color = Color3.fromRGB(255, 248, 225),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = m,
		})
		table.insert(lights, hl)
		part({
			Name = "Ruecklicht",
			Size = Vector3.new(1.4, 0.3, 0.15),
			CFrame = CFrame.new(x, 0.4, 6.0),
			Color = Color3.fromRGB(220, 20, 25),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = m,
		})
	end

	-- Räder mit Felgen (VL, VR, HL, HR – vorne ist -Z)
	local wheels = {}
	for i, w in ipairs({ { -3.05, -3.8 }, { 3.05, -3.8 }, { -3.05, 3.8 }, { 3.05, 3.8 } }) do
		local cf = CFrame.new(w[1], -0.5, w[2])
		local wheel = { Index = i, CFrame = cf, Front = w[2] < 0, Parts = {} }
		wheels[i] = wheel
		table.insert(wheel.Parts, part({ Name = "Reifen", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.0, 2.4, 2.4), CFrame = cf, Color = TIRE, Material = Enum.Material.Rubber, CanCollide = false, Parent = m }))
		-- Speichen, damit man das Drehen sieht
		for k = 0, 2 do
			table.insert(wheel.Parts, part({
				Name = "Speiche",
				Size = Vector3.new(1.08, 1.5, 0.22),
				CFrame = cf * CFrame.Angles(k * math.pi / 3, 0, 0),
				Color = Color3.fromRGB(60, 60, 66),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = m,
			}))
		end
		table.insert(wheel.Parts, part({
			Name = "Felge",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.06, 1.6, 1.6),
			CFrame = cf,
			Color = def.Hp >= 400 and Color3.fromRGB(40, 40, 44) or CHROME,
			Material = Enum.Material.Metal,
			Reflectance = 0.25,
			CanCollide = false,
			Parent = m,
		}))
		table.insert(wheel.Parts, part({ Name = "Nabe", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.12, 0.5, 0.5), CFrame = cf, Color = Color3.fromRGB(70, 70, 75), CanCollide = false, Parent = m }))
	end

	-- Auspuff
	for _, x in ipairs({ -1.6, 1.6 }) do
		part({
			Name = "Auspuff",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.8, 0.45, 0.45),
			CFrame = CFrame.new(x, -0.7, 6.3) * CFrame.Angles(0, math.rad(90), 0),
			Color = CHROME,
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = m,
		})
	end

	-- Heckflügel für starke Autos
	if def.Hp >= 400 then
		trim("Fluegel", Vector3.new(6.0, 0.15, 1.2), CFrame.new(0, 1.55, 5.5))
		for _, x in ipairs({ -2, 2 }) do
			trim("FluegelStuetze", Vector3.new(0.2, 0.7, 0.3), CFrame.new(x, 1.15, 5.5))
		end
	end

	return lights, wheels
end

-- Verankertes Auto für die Werkstatt. Pivot = Karosseriemitte.
function Cars.MakeShowCar(def)
	local m = Instance.new("Model")
	m.Name = def.Name
	buildVisual(def, m, false)
	local root = part({
		Name = "Wurzel",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(),
		Transparency = 1,
		CanCollide = false,
		Parent = m,
	})
	-- Unsichtbarer Block, damit niemand durch das geparkte Auto läuft.
	-- Wird vom Server nur eingeschaltet, solange das Auto steht.
	part({
		Name = "Kollision",
		Size = Vector3.new(6, 2.2, 12),
		CFrame = CFrame.new(0, 0, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = m,
	})
	m.PrimaryPart = root
	return m
end

-- Fahrbares Auto. Pivot = Fahrgestell (CHASSIS_HEIGHT über Boden).
-- Gelenkt wird vom Client (DriveClient) über "Antrieb" und "Lenkung".
function Cars.MakeDrivable(def)
	local m = Instance.new("Model")
	m.Name = def.Name
	local lights, wheels = buildVisual(def, m, true)

	local slippery = PhysicalProperties.new(0.7, 0, 0, 100, 1)
	local chassis = part({
		Name = "Fahrgestell",
		Size = Vector3.new(5.6, 1, 11.4),
		CFrame = CFrame.new(0, Cars.CHASSIS_HEIGHT - Cars.BODY_HEIGHT, 0),
		Transparency = 1,
		CanCollide = true,
		CustomPhysicalProperties = slippery,
		Parent = m,
	})
	-- Kugeln als Kontakt zum Boden: rollen über kleine Kanten
	for _, w in ipairs({ { -2.4, -3.8 }, { 2.4, -3.8 }, { -2.4, 3.8 }, { 2.4, 3.8 } }) do
		part({
			Name = "Kontakt",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.2, 1.2, 1.2),
			CFrame = CFrame.new(w[1], 0.6 - Cars.BODY_HEIGHT, w[2]),
			Transparency = 1,
			CanCollide = true,
			CustomPhysicalProperties = slippery,
			Parent = m,
		})
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "Fahrersitz"
	seat.Size = Vector3.new(1.6, 0.4, 1.6)
	seat.CFrame = CFrame.new(-1.3, 0.9 - Cars.BODY_HEIGHT + 0.6, 1.2)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Anchored = true
	seat.Parent = m

	for _, hl in ipairs(lights) do
		Util.light(hl, "SpotLight", { Face = Enum.NormalId.Front, Range = 60, Brightness = 2, Angle = 70, Color = Color3.fromRGB(255, 245, 225) })
	end

	-- Räder: jedes Rad hängt an einer unsichtbaren Nabe, die über ein Motor6D
	-- am Fahrgestell sitzt. Der Fahrer-Client dreht und lenkt sie (DriveClient).
	local skip = {}
	for _, wheel in ipairs(wheels) do
		local hub = part({
			Name = "Radnabe",
			Size = Vector3.new(0.4, 0.4, 0.4),
			CFrame = wheel.CFrame,
			Transparency = 1,
			CanCollide = false,
			Parent = m,
		})
		for _, wp in ipairs(wheel.Parts) do
			wp.Anchored = false
			wp.Massless = true
			local w = Instance.new("WeldConstraint")
			w.Part0 = hub
			w.Part1 = wp
			w.Parent = wp
			skip[wp] = true
		end
		hub.Anchored = false
		hub.Massless = true
		local motor = Instance.new("Motor6D")
		motor.Name = (wheel.Front and "RadVorne" or "RadHinten") .. wheel.Index
		motor.Part0 = chassis
		motor.Part1 = hub
		motor.C0 = chassis.CFrame:Inverse() * hub.CFrame
		motor.C1 = CFrame.new()
		motor:SetAttribute("Front", wheel.Front)
		motor.Parent = chassis
		skip[hub] = true
	end
	-- Lenkrad dreht sich mit
	local wheelPart = m:FindFirstChild("Lenkrad")
	if wheelPart then
		wheelPart.Anchored = false
		wheelPart.Massless = true
		local motor = Instance.new("Motor6D")
		motor.Name = "LenkradMotor"
		motor.Part0 = chassis
		motor.Part1 = wheelPart
		motor.C0 = chassis.CFrame:Inverse() * wheelPart.CFrame
		motor.C1 = CFrame.new()
		motor.Parent = chassis
		skip[wheelPart] = true
	end

	-- Alles andere ans Fahrgestell schweißen
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= chassis and not skip[d] then
			d.Anchored = false
			d.Massless = true
			local w = Instance.new("WeldConstraint")
			w.Part0 = chassis
			w.Part1 = d
			w.Parent = d
		end
	end
	chassis.Anchored = false

	local att = Instance.new("Attachment")
	att.Name = "Mitte"
	att.Parent = chassis

	local lv = Instance.new("LinearVelocity")
	lv.Name = "Antrieb"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	lv.PrimaryTangentAxis = Vector3.xAxis
	lv.SecondaryTangentAxis = Vector3.zAxis
	lv.PlaneVelocity = Vector2.zero
	lv.MaxForce = 12000
	lv.Parent = chassis

	local av = Instance.new("AngularVelocity")
	av.Name = "Lenkung"
	av.Attachment0 = att
	av.RelativeTo = Enum.ActuatorRelativeTo.World
	av.AngularVelocity = Vector3.zero
	av.MaxTorque = 60000
	av.Parent = chassis

	m.PrimaryPart = chassis
	return m, seat
end

return Cars
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000004"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- Chiptuning-Firma: Server
-- Script "GameServer" in ServerScriptService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

------------------------------------------------------------------------
-- Remotes
------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function newRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end

local OpenTuning = newRemote("OpenTuning") -- Server -> Client: Tuning-Fenster öffnen
local FinishTuning = newRemote("FinishTuning") -- Client -> Server: Nadel-Positionen
local CancelTuning = newRemote("CancelTuning") -- Client -> Server
local TuneResult = newRemote("TuneResult") -- Server -> Client: Ergebnis
local OpenShop = newRemote("OpenShop") -- Server -> Client
local BuyUpgrade = newRemote("BuyUpgrade") -- Client -> Server
local Notify = newRemote("Notify") -- Server -> Client: Meldung
local RequestTestDrive = newRemote("RequestTestDrive") -- Client -> Server
local RequestCompanyCar = newRemote("RequestCompanyCar") -- Client -> Server
local EndDrive = newRemote("EndDrive") -- Client -> Server
remotes.Parent = ReplicatedStorage

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "info")
end

------------------------------------------------------------------------
-- Module
------------------------------------------------------------------------
local Util = require(script.Parent:WaitForChild("Util"))
local World = require(script.Parent:WaitForChild("World"))
local Cars = require(script.Parent:WaitForChild("Cars"))

local part, textGui, billboard = Util.part, Util.textGui, Util.billboard
local lookCF, moveModel = Util.lookCF, Util.moveModel

World.Build()

local ROAD_Z = World.ROAD_Z
local PLOT_SPACING = World.PLOT_SPACING
local BAY_X = { -27, -9, 9, 27 }
local BAY_Z = -12
local DYNO_POS = Vector3.new(26, 0, 18)
local LIFT_TOP = 1.0 -- Oberkante der Fahrschienen (unten)
local LIFT_UP = 5.5 -- so weit fährt die Bühne hoch

------------------------------------------------------------------------
-- Spielerdaten
------------------------------------------------------------------------
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Chiptuning] DataStore nicht verfügbar: " .. tostring(result))
	end
end

local States = {} -- [player] = Zustand
local usedPlots = {} -- [index] = player
local jobCounter = 0

local function defaultData()
	return { Money = Config.StartMoney, Rep = 0, Tunes = 0, Upgrades = {}, Receipts = {} }
end

local function loadData(player)
	if not store then
		return defaultData(), false
	end
	local ok, res = pcall(function()
		return store:GetAsync("p_" .. player.UserId)
	end)
	if not ok then
		warn("[Chiptuning] Laden fehlgeschlagen: " .. tostring(res))
		return defaultData(), false
	end
	local data = defaultData()
	if type(res) == "table" then
		data.Money = tonumber(res.Money) or data.Money
		data.Rep = tonumber(res.Rep) or 0
		data.Tunes = tonumber(res.Tunes) or 0
		if type(res.Upgrades) == "table" then
			for id, owned in pairs(res.Upgrades) do
				if owned == true and Config.GetUpgrade(id) then
					data.Upgrades[id] = true
				end
			end
		end
		if type(res.Receipts) == "table" then
			for _, r in ipairs(res.Receipts) do
				if type(r) == "string" then
					table.insert(data.Receipts, r)
				end
			end
		end
	end
	return data, true
end

-- Gibt true zurück, wenn gespeichert wurde
local function saveData(player, st)
	if not (store and st.CanSave) then
		return false
	end
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, {
			Money = st.Data.Money,
			Rep = st.Data.Rep,
			Tunes = st.Data.Tunes,
			Upgrades = st.Data.Upgrades,
			Receipts = st.Data.Receipts,
		})
	end)
	if not ok then
		warn("[Chiptuning] Speichern fehlgeschlagen: " .. tostring(err))
	end
	return ok
end

local function hasUpgrade(st, id)
	return st.Data.Upgrades[id] == true
end

local function hasPass(st, key)
	return st.Passes[key] == true
end

local function maxStage(st)
	if hasUpgrade(st, "Stage3") then
		return 3
	elseif hasUpgrade(st, "Stage2") then
		return 2
	end
	return 1
end

local function isBayUnlocked(st, index)
	return index == 1 or hasUpgrade(st, "Bay" .. index)
end

local function setMoney(st, value)
	st.Data.Money = value
	st.MoneyValue.Value = value
end

local function setRep(st, value)
	st.Data.Rep = value
	st.RepValue.Value = value
end

-- Karosseriemitte über dem Boden (Ausstellungsautos)
local CAR_HEIGHT = Cars.BODY_HEIGHT

------------------------------------------------------------------------
-- Werkstatt (Grundstück)
------------------------------------------------------------------------
local function buildLock(plot, bay)
	local lock = part({
		Name = "Gesperrt",
		Size = Vector3.new(14, 6, 22),
		CFrame = plot.Origin * CFrame.new(bay.X, 4, BAY_Z),
		Color = Color3.fromRGB(200, 40, 40),
		Material = Enum.Material.ForceField,
		Transparency = 0.3,
		CanCollide = false,
		Parent = plot.Model,
	})
	billboard(lock, "🔒 Hebebühne " .. bay.Index .. "\nim Shop freischalten", 1)
	bay.Lock = lock
end

local function buildDyno(plot, owned)
	if plot.Dyno then
		plot.Dyno:Destroy()
	end
	local dyno = Instance.new("Model")
	dyno.Name = "Pruefstand"
	local base = plot.Origin * CFrame.new(DYNO_POS)
	local pad = part({
		Name = "Platte",
		Size = Vector3.new(10, 0.4, 16),
		CFrame = base * CFrame.new(0, 0.6, 0),
		Color = owned and Color3.fromRGB(40, 40, 45) or Color3.fromRGB(120, 120, 125),
		Material = Enum.Material.DiamondPlate,
		Transparency = owned and 0 or 0.6,
		Parent = dyno,
	})
	if owned then
		for _, z in ipairs({ -3.8, 3.8 }) do
			part({
				Name = "Rolle",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(8, 1, 1),
				CFrame = base * CFrame.new(0, 0.85, z),
				Color = Color3.fromRGB(180, 180, 190),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = dyno,
			})
		end
		local screen = part({
			Name = "Monitor",
			Size = Vector3.new(6, 4, 0.4),
			CFrame = base * CFrame.new(7, 5, -4) * CFrame.Angles(0, math.rad(-35), 0),
			Color = Color3.fromRGB(10, 10, 12),
			Parent = dyno,
		})
		part({
			Name = "Staender",
			Size = Vector3.new(0.4, 3, 0.4),
			CFrame = base * CFrame.new(7, 1.9, -4),
			Color = Color3.fromRGB(60, 60, 60),
			Parent = dyno,
		})
		plot.DynoScreen = textGui(screen, Enum.NormalId.Back, "PRÜFSTAND\nbereit", Color3.fromRGB(80, 255, 120), Color3.fromRGB(10, 14, 12))
	else
		billboard(pad, "Leistungsprüfstand\n(im Shop kaufen)", 3)
		plot.DynoScreen = nil
	end
	dyno.Parent = plot.Model
	plot.Dyno = dyno
end

local function buildPlot(player, st, index)
