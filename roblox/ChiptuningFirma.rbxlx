-- HUD (Geld, Ruf, Shop-Knopf, Hinweis)
------------------------------------------------------------------------
local hud = make("Frame", {
	Size = UDim2.fromOffset(330, 46),
	Position = UDim2.new(0.5, 0, 0, 8),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundColor3 = C.Bg,
