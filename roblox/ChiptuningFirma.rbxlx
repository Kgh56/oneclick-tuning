	BackgroundColor3 = Color3.fromRGB(50, 52, 60),
	BorderSizePixel = 0,
}, panel)
local rpmBar = make("Frame", {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = Color3.fromRGB(255, 140, 0),
